# run-benchmark and `rhenium benchmark` read this file; variables already set win.

# Codex API for run-benchmark codex and rhenium benchmark --provider codex.
# Optional when codex is already logged in; OPENAI_BASE_URL and CODEX_MODEL are optional.
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# CODEX_MODEL="<model-id>"

# Claude Code API for run-benchmark claude and rhenium benchmark --provider claude.
# Optional when claude is already logged in; otherwise set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_AUTH_TOKEN="..."
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# ANTHROPIC_MODEL="<model-id>"

# Optional Hub paths.
# RHENIUM_ROOT="/absolute/path/to/rhenium"
# RHENIUM_BENCHMARK_PATH="/absolute/path/to/benchmarks"
# RHENIUM_STATE_DIR="/absolute/path/to/rhenium/.rhenium/hub"
# RHENIUM_CACHE_DIR="/absolute/path/to/rhenium/.rhenium/hub/cache"

# mini-swe-agent model-under-test path used by run-benchmark, rhenium run-model,
# rhenium benchmark --provider api, and the API.
# RHENIUM_MODEL_ENABLED="true"
# RHENIUM_MODEL_NAME="openai/<model-id>"
# RHENIUM_MODEL_CLASS="litellm"
# RHENIUM_MODEL_BASE_URL="https://api.openai.com/v1"
# RHENIUM_MODEL_MAX_STEPS="100"
# RHENIUM_MODEL_API_KEY="sk-..."
