+++ b/cfw/lua/cfw/extensions/mass_sv.lua
@@ -16,6 +16,22 @@
     if con then
         con.totalMass = con.totalMass + (newMass - oldMass)
     end
+
+    local family = ent:GetFamily()
+
+    if family then
+        local total = 0
+
+        for member in pairs(family.ents) do
+            local phys = IsValid(member) and member:GetPhysicsObject()
