diff -u a/starfallex/lua/starfall/libs_sh/quaternion.lua b/starfallex/lua/starfall/libs_sh/quaternion.lua
--- a/starfallex/lua/starfall/libs_sh/quaternion.lua
+++ b/starfallex/lua/starfall/libs_sh/quaternion.lua
@@ -859,19 +859,26 @@
 		return wrap({ 0, 0, 0, 0})
 	else
 		local new = clone(quat2)
-		if getQuatDot(quat1, quat2) < 0 then
+		local dot = getQuatDot(quat1, quat2)
+		if dot < 0 then
 			quatFlip(new)
+			dot = -dot
 		end
 
-		local out = clone(quat1)
-		quatInv(out)
-		quatConj(out)
-		out = getQuatMul(out, new)
-		quatLog(out)
-		quatMulNum(out, t)
-		quatExp(out)
+		local wa, wb
+		if dot > 0.9995 then
+			wa, wb = 1 - t, t
+		else
+			local theta = math.acos(math.min(dot, 1))
+			local sine = math.sin(theta)
+			wa, wb = math.sin((1 - t) * theta) / sine, math.sin(t * theta) / sine
+		end
 
-		return wrap(getQuatMul(quat1, out))
+		local out = {}
+		for i = 1, 4 do
+			out[i] = wa * quat1[i] + wb * new[i]
+		end
+		return wrap(out)
 	end
 end
 
