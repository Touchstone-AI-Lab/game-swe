@@ -87,8 +87,9 @@
 --- Gets the string representation of the entity
 -- @return string String representation of the entity
 function ent_meta:__tostring()
-	local ent = eunwrap(self)
-	return Ent_IsValid(ent) and tostring(ent) or "(null entity)"
