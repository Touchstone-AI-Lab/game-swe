diff -u a/starfallex/lua/starfall/libs_sh/builtins.lua b/starfallex/lua/starfall/libs_sh/builtins.lua
--- a/starfallex/lua/starfall/libs_sh/builtins.lua
+++ b/starfallex/lua/starfall/libs_sh/builtins.lua
@@ -962,8 +962,13 @@
 -- @param table? env Environment of compiled function
 -- @return function? Compiled function, or nil if failed to compile
 -- @return string? Error string, or nil if successfully compiled
-function builtins_library.loadstring(ld, source)
+function builtins_library.loadstring(ld, source, env)
 	checkluatype(ld, TYPE_STRING)
+	local targetEnv = instance.env
+	if env ~= nil then
+		checkluatype(env, TYPE_TABLE)
+		targetEnv = env
+	end
 	if source == nil then
 		source = "=(load)"
 	else
@@ -972,7 +977,7 @@
 	source = "SF:"..source
 	local retval = SF.CompileString(ld, source, false)
 	if isfunction(retval) then
-		return setfenv(retval, instance.env)
+		return setfenv(retval, targetEnv)
 	end
 	return nil, tostring(retval)
 end
