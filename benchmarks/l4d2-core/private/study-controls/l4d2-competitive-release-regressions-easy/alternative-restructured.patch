diff -ruN a/addons/sourcemod/scripting/l4d2_fix_changelevel.sp b/addons/sourcemod/scripting/l4d2_fix_changelevel.sp
--- a/addons/sourcemod/scripting/l4d2_fix_changelevel.sp	2026-09-21 05:40:05.639421042 +0800
+++ b/addons/sourcemod/scripting/l4d2_fix_changelevel.sp	2026-09-21 05:40:05.643265816 +0800
@@ -160,8 +160,19 @@
 	// if (!hParams.IsNull(2))
 	//	hParams.GetString(2, reason, sizeof(reason));
 
+	// Callers such as sm_map hand the engine a unique partial name. Resolve it
+	// first so the engine and the Director work below agree on one full name.
+	char installed[64];
+	MRESReturn result = MRES_Ignored;
+	if (ResolveInstalledMap(map, installed, sizeof(installed)))
+	{
+		hParams.SetString(1, installed);
+		strcopy(map, sizeof(map), installed);
+		result = MRES_ChangedHandled;
+	}
+
 	if (TheDirector.IsTransitioning())
-		return MRES_Ignored;
+		return result;
 
 	TheDirector.ClearTeamScores(true);
 
@@ -173,7 +184,29 @@
 	TheDirector.OnBeginTransition(false);
 	GameRules__OnBeginChangeLevel(map);
 
-	return MRES_Ignored;
+	return result;
+}
+
+/**
+ * Looks the requested name up in the installed maps.
+ *
+ * @return true only when the lookup produced a different, installed full name.
+ */
+bool ResolveInstalledMap(const char[] requested, char[] installed, int maxlength)
+{
+	switch (FindMap(requested, installed, maxlength))
+	{
+		case FindMap_NotFound, FindMap_PossiblyAvailable:
+		{
+			return false;
+		}
+		case FindMap_Found, FindMap_NonCanonical, FindMap_FuzzyMatch:
+		{
+			return installed[0] != '\0' && strcmp(requested, installed) != 0;
+		}
+	}
+
+	return false;
 }
 
 void GameRules__OnBeginChangeLevel(const char[] map)
