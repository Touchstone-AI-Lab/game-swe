@@ -21,22 +21,36 @@
 	if (!IsClientInGame(client) || GetClientTeam(client) != 2)
 		return Plugin_Continue;
 
-	if (GetEntProp(client, Prop_Send, "m_isIncapacitated", 1) > 0)
-	{
-		int wep = GetEntPropEnt(client, Prop_Send, "m_hActiveWeapon");
-		if (wep != -1)
-			SetEntPropFloat(wep, Prop_Send, "m_flNextSecondaryAttack", GetGameTime() + BUFFER_TIME);
+	int wep = GetEntPropEnt(client, Prop_Send, "m_hActiveWeapon");
 
-		g_bBlocked[client] = true;
-	}
-	else if (g_bBlocked[client])
+	if (GetEntProp(client, Prop_Send, "m_isIncapacitated", 1) <= 0)
 	{
-		int wep = GetEntPropEnt(client, Prop_Send, "m_hActiveWeapon");
-		if (wep != -1)
-			SetEntPropFloat(wep, Prop_Send, "m_flNextSecondaryAttack", GetGameTime());
-
-		g_bBlocked[client] = false;
+		// Not incapacitated: hand back a delay we own, then stay out of the way.
+		ReleaseOwnedDelay(client, wep);
+		return Plugin_Continue;
 	}
 
+	// No weapon, or nothing left in the clip: the engine needs the secondary
+	// attack timestamp untouched so its automatic reload can start.
+	if (wep == -1 || !WeaponHasLoadedClip(wep))
+		return Plugin_Continue;
+
+	SetEntPropFloat(wep, Prop_Send, "m_flNextSecondaryAttack", GetGameTime() + BUFFER_TIME);
+	g_bBlocked[client] = true;
 	return Plugin_Continue;
 }
+
+bool WeaponHasLoadedClip(int wep)
+{
+	return HasEntProp(wep, Prop_Send, "m_iClip1") && GetEntProp(wep, Prop_Send, "m_iClip1") > 0;
+}
+
+void ReleaseOwnedDelay(int client, int wep)
+{
+	if (!g_bBlocked[client])
+		return;
+
+	g_bBlocked[client] = false;
+	if (wep != -1)
+		SetEntPropFloat(wep, Prop_Send, "m_flNextSecondaryAttack", GetGameTime());
+}
