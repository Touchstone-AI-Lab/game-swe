+// Confogl announces the end of a matchmode while left4dhooks is still loaded.
+// Everything this plugin owns goes back to the saved pre-mode state here.
+public void LGO_OnMatchModeUnloaded()
+{
+    RestoreOwnedState();
+}
+
+void RestoreOwnedState()
+{
+    // plugin-managed multipliers: drop the values first, then the hooks
+    hTankDamageAttri.Clear();
+    OnTankDamageEnableAttriChanged(false);
+
+    hReloadDurationAttri.Clear();
+    OnReloadDurationEnableAttriChanged(false);
+
+    // ordinary engine attributes: write the saved defaults back and forget them
+    ResetWeaponAttributes(true);
+    ResetMeleeAttributes(true);
+}
+
 void OnTankDamageEnableAttriChanged(bool newValue)
 {
     if (bTankDamageEnableAttri != newValue) {
