 // 对witch伤害和对小僵尸伤害不会触发这个事件
 // witch伤害不记录，tank伤害单独记录
 ::LinGe.HUD.tempTeamHurt <- {}; // 友伤临时数据记录
+::LinGe.HUD.tankPreHealth <- {}; // Tank 在最近一次伤害生效前的真实血量，以实体索引为key
+
+// 部分伤害事件报告的 dmg_health 小于实际扣除的血量，此表记录其倍数
+// 第一层key为weapon，第二层key为伤害类型
+::LinGe.HUD.underReportedDamage <- {
+	entityflame = { [268435464] = 3 }
+};
+::LinGe.HUD.ReportedDamageScale <- function (params)
+{
+	if (!params.rawin("weapon") || !underReportedDamage.rawin(params.weapon))
+		return 1;
+	local byType = underReportedDamage[params.weapon];
+	return byType.rawin(params.type) ? byType[params.type] : 1;
+}.bindenv(::LinGe.HUD);
+
+// 记录一次友伤：累计统计 + 延迟提示所需的临时数据
+::LinGe.HUD.RecordTeamHurt <- function (attackerID, victimID, attacker, victim, dmg, lethal, incap)
+{
+	// 对自己造成的伤害不计入友伤统计
+	if (attacker != victim)
+	{
+		hurtData[attacker.GetEntityIndex()].atk += dmg;
+		hurtData[attacker.GetEntityIndex()].t_atk += dmg;
+		hurtData[victim.GetEntityIndex()].vct += dmg;
+		hurtData[victim.GetEntityIndex()].t_vct += dmg;
+	}
+
+	if (Config.hurt.teamHurtInfo < 1 || Config.hurt.teamHurtInfo > 2)
+		return;
+	local key = attackerID + "_" + victimID;
+	if (!tempTeamHurt.rawin(key))
+	{
+		tempTeamHurt[key] <- { dmg=0, attacker=attacker, atkName=attacker.GetPlayerName(),
+			victim=victim, vctName=victim.GetPlayerName(), isDead=false, isIncap=false };
+	}
+	local info = tempTeamHurt[key];
+	info.dmg += dmg;
+	if (lethal)
+		info.isDead = true;
+	if (incap)
+		info.isIncap = true;
+	// 友伤发生后，0.5秒内同一人若未再对同一人造成友伤，则输出其造成的伤害
+	VSLib.Timers.AddTimerByName(key, 0.5, false, Timer_PrintTeamHurt, key);
+}.bindenv(::LinGe.HUD);
+
+// 伤害生效前记录 Tank 的真实血量，用于修正进入死亡过渡那一击的溢出
+::LinGe.HUD.OnTakeDamage_TankSnapshot <- function (damageTable)
+{
+	local victim = damageTable.Victim;
+	local attacker = damageTable.Attacker;
+	if (victim == null || attacker == null)
+		return;
+	if (victim.GetClassname() != "player" || attacker.GetClassname() != "player")
+		return;
+	if (victim.IsSurvivor() || 8 != victim.GetZombieType() || !attacker.IsSurvivor())
+		return;
+	if (victim.IsIncapacitated())
+		return;
+	tankPreHealth[victim.GetEntityIndex()] <- victim.GetHealth();
+}.bindenv(::LinGe.HUD);
+::VSLib.EasyLogic.OnTakeDamage.LinGeHUD_TankSnapshot <- ::LinGe.HUD.OnTakeDamage_TankSnapshot;
+
+// 事件：生还者即将倒地，此时仍可读取倒地前的实血与虚血
+::LinGe.HUD.OnGameEvent_player_incapacitated_start <- function (params)
+{
+	if (!params.rawin("userid") || params.userid == 0 || !params.rawin("attacker"))
+		return;
+	local victim = GetPlayerFromUserID(params.userid);
+	local attacker = GetPlayerFromUserID(params.attacker);
+	if (null == victim || null == attacker)
+		return;
+	if (!victim.IsSurvivor() || !attacker.IsSurvivor())
+		return;
+	local dmg = victim.GetHealth() + victim.GetHealthBuffer().tointeger();
+	if (dmg < 1)
+		return;
+	RecordTeamHurt(params.attacker, params.userid, attacker, victim, dmg, false, true);
+}
+::LinEventHook("OnGameEvent_player_incapacitated_start", ::LinGe.HUD.OnGameEvent_player_incapacitated_start, ::LinGe.HUD);
