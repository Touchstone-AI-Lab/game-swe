 static void SetEnforcedCvars()
 {
-	int iSize = CvarSettingsArray.Length;
-
-	CVSEntry cvsetting;
-
-	for (int i = 0; i < iSize; i++) {
-		CvarSettingsArray.GetArray(i, cvsetting, sizeof(cvsetting));
-
