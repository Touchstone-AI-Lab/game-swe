+
+static bool MI_SelectSubsection(const char[] path)
+{
+    int start = 0, length = strlen(path);
+    char part[256];
+    for (int i = 0; i <= length; i++) {
+        if (path[i] != '/' && path[i] != 0) continue;
+        int size = i-start;
+        if (size <= 0 || size >= sizeof(part)) return false;
+        strcopy(part, size+1, path[start]);
+        if (!g_hMIData.JumpToKey(part, false)) return false;
+        start = i+1;
+    }
+    return true;
+}
