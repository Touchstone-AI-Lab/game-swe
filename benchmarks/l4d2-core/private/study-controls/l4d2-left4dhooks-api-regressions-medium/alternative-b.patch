+bool g_bBlock_CPhysicsProp_OnTakeDamage;
+bool g_bPhysicsPropGasCan;
+int g_iPhysicsPropGasCan;
+
+bool IsPhysicsGasCan(int entity)
+{
+	return g_iGasCanModel != 0 && IsValidEntity(entity) && GetEntProp(entity, Prop_Send, "m_nModelIndex") == g_iGasCanModel;
+}
+
+MRESReturn DTR_CPhysicsProp_OnTakeDamage(int pThis, DHookReturn hReturn, DHookParam hParams)
+{
+	if( !IsPhysicsGasCan(pThis) )
+		return MRES_Ignored;
+
+	g_bPhysicsPropGasCan = true;
+	g_iPhysicsPropGasCan = pThis;
+	g_bBlock_CPhysicsProp_OnTakeDamage = false;
+
+	int inflictor = hParams.GetObjectVar(1, 48, ObjectValueType_EhandlePtr);
+	int attacker = hParams.GetObjectVar(1, 52, ObjectValueType_EhandlePtr);
+
+	Action aResult = Plugin_Continue;
+	Call_StartForward(g_hFWD_CGasCanEvent_Killed);
+	Call_PushCell(pThis);
+	Call_PushCellRef(inflictor);
+	Call_PushCellRef(attacker);
+	Call_Finish(aResult);
+
+	if( aResult == Plugin_Handled )
+	{
+		g_bBlock_CPhysicsProp_OnTakeDamage = true;
+		hReturn.Value = 0;
+		return MRES_Supercede;
+	}
+
+	if( aResult == Plugin_Changed )
+	{
+		hParams.SetObjectVar(1, 48, ObjectValueType_EhandlePtr, inflictor);
+		hParams.SetObjectVar(1, 52, ObjectValueType_EhandlePtr, attacker);
+		return MRES_ChangedHandled;
+	}
+
+	return MRES_Ignored;
+}
+
+MRESReturn DTR_CPhysicsProp_OnTakeDamage_Post(int pThis, DHookReturn hReturn, DHookParam hParams)
+{
+	if( !g_bPhysicsPropGasCan || pThis != g_iPhysicsPropGasCan )
+		return MRES_Ignored;
+
+	int inflictor = hParams.GetObjectVar(1, 48, ObjectValueType_EhandlePtr);
+	int attacker = hParams.GetObjectVar(1, 52, ObjectValueType_EhandlePtr);
+
+	Call_StartForward(g_bBlock_CPhysicsProp_OnTakeDamage ? g_hFWD_CGasCanEvent_Killed_PostHandled : g_hFWD_CGasCanEvent_Killed_Post);
+	Call_PushCell(pThis);
+	Call_PushCell(inflictor);
+	Call_PushCell(attacker);
+	Call_Finish();
+
+	g_bPhysicsPropGasCan = false;
+	g_iPhysicsPropGasCan = 0;
+	return MRES_Ignored;
+}
+
