+float flClampRewardStack(float current, float incoming, float min, float max, bool add = true, float fallback = -1.0)
+{
+	float value = current;
+	if (0.0 < incoming <= current)
+	{
+		value = add ? (current + incoming) : (current - incoming);
+	}
+	else if (current <= 0.0 && incoming > 0.0)
+	{
+		value = incoming;
+	}
+
+	return (value > 0.0) ? flClamp(value, min, max) : fallback;
+}
+
+int iClampRewardStack(int current, int incoming, int min, int max, int type = 0, int fallback = -1)
+{
+	int value = current;
+	if (0 < incoming <= current)
+	{
+		value = (type == 0) ? (current + incoming) : ((type == 1) ? (current - incoming) : (current|incoming));
+	}
+	else if (current <= 0 && incoming > 0)
+	{
+		value = incoming;
+	}
+
+	return (value > 0) ? iClamp(value, min, max) : fallback;
+}
