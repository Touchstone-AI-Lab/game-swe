+MRESReturn DTR_CPhysicsProp_OnTakeDamage(int pThis, DHookReturn hReturn, DHookParam hParams)
+{
+	if( !IsValidEntity(pThis) || GetEntProp(pThis, Prop_Send, "m_nModelIndex") != g_iGasCanModel )
+		return MRES_Ignored;
+
+	// Picked-up cans are CGasCan entities and retain the existing
+	// CGasCan::Event_Killed path. This bridge is only for the raw physics
+	// prop used by cans that have never entered an inventory.
+	char classname[32];
+	GetEntityClassname(pThis, classname, sizeof(classname));
+	if( strncmp(classname, "prop_physics", 12, false) != 0 )
+		return MRES_Ignored;
+
+	float damage = hParams.GetObjectVar(1, 60, ObjectValueType_Float);
+	int health = GetEntProp(pThis, Prop_Data, "m_iHealth");
+	if( health <= 0 || damage < float(health) )
+		return MRES_Ignored;
+
+	// Physics damage may recurse while an exploding prop damages nearby
+	// props, so retain the matching pre/post state as a call stack.
+	int state[2];
+	state[0] = pThis;
+	int stateIndex = g_aPhysicalGasCanForwards.PushArray(state, sizeof(state));
+
+	int inflictor = hParams.GetObjectVar(1, 48, ObjectValueType_EhandlePtr);
+	int attacker = hParams.GetObjectVar(1, 52, ObjectValueType_EhandlePtr);
+
+	Action aResult = Plugin_Continue;
+	Call_StartForward(g_hFWD_CGasCanEvent_Killed);
+	Call_PushCell(pThis);
+	Call_PushCellRef(inflictor);
+	Call_PushCellRef(attacker);
+	Call_Finish(aResult);
+
+	if( aResult == Plugin_Handled )
+	{
+		g_aPhysicalGasCanForwards.Set(stateIndex, true, 1);
+		hReturn.Value = 0;
+		return MRES_Supercede;
+	}
+
+	if( aResult == Plugin_Changed )
+	{
+		hParams.SetObjectVar(1, 48, ObjectValueType_EhandlePtr, inflictor);
+		hParams.SetObjectVar(1, 52, ObjectValueType_EhandlePtr, attacker);
+		return MRES_ChangedHandled;
+	}
+
+	return MRES_Ignored;
+}
+
+MRESReturn DTR_CPhysicsProp_OnTakeDamage_Post(int pThis, DHookReturn hReturn, DHookParam hParams)
+{
+	int stateIndex = g_aPhysicalGasCanForwards.Length - 1;
+	if( stateIndex < 0 || g_aPhysicalGasCanForwards.Get(stateIndex, 0) != pThis )
+		return MRES_Ignored;
+
+	bool blocked = g_aPhysicalGasCanForwards.Get(stateIndex, 1);
+	g_aPhysicalGasCanForwards.Erase(stateIndex);
+
+	int inflictor = hParams.GetObjectVar(1, 48, ObjectValueType_EhandlePtr);
+	int attacker = hParams.GetObjectVar(1, 52, ObjectValueType_EhandlePtr);
+
+	Call_StartForward(blocked ? g_hFWD_CGasCanEvent_Killed_PostHandled : g_hFWD_CGasCanEvent_Killed_Post);
+	Call_PushCell(pThis);
+	Call_PushCell(inflictor);
+	Call_PushCell(attacker);
+	Call_Finish();
+
+	return MRES_Ignored;
+}
