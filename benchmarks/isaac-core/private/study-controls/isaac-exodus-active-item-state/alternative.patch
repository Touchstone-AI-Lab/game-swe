+function Exodus:anamnesisChargeUpdate()
+    local player = Isaac.GetPlayer(0)
+    local memory = ItemVariables.ANAMNESIS
+    
+    if memory == nil then
+        memory = { InSlot = false, Charge = 0 }
+        ItemVariables.ANAMNESIS = memory
+    end
+    
+    if player:GetActiveItem() == ItemId.ANAMNESIS then
+        if memory.InSlot then
+            -- While it sits in the slot, whatever it gains or spends is its own.
+            memory.Charge = player:GetActiveCharge()
+        else
+            -- It has just entered the slot: it arrives with its own remembered charge, not the slot's.
+            memory.InSlot = true
+            player:SetActiveCharge(memory.Charge)
+        end
+    else
+        memory.InSlot = false
+    end
+end
+
+Exodus:AddCallback(ModCallbacks.MC_POST_UPDATE, Exodus.anamnesisChargeUpdate)
+
