+--<<<FAMILIAR OWNERSHIP>>>--
+local FamiliarOwners = {
+    [Entities.CANDLE.variant] = ItemId.RITUAL_CANDLE,
+    [Entities.SUN.variant] = ItemId.SUNDIAL,
+    [Entities.SHADOW.variant] = ItemId.SUNDIAL,
+    [Entities.ASTRO_BABY.variant] = ItemId.ASTRO_BABY,
+    [Entities.LIL_RUNE.variant] = ItemId.LIL_RUNE
+}
+
+function Exodus:familiarOwnershipUpdate()
+    local player = Isaac.GetPlayer(0)
+    
+    for i, entity in pairs(Isaac.GetRoomEntities()) do
+        if entity.Type == EntityType.ENTITY_FAMILIAR then
+            local owner = FamiliarOwners[entity.Variant]
+            
+            if owner ~= nil and not player:HasCollectible(owner) then
+                entity:Remove()
+            end
+        end
+    end
+end
+
+Exodus:AddCallback(ModCallbacks.MC_POST_UPDATE, Exodus.familiarOwnershipUpdate)
