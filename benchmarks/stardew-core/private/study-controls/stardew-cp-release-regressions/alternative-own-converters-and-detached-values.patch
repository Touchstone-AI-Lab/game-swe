diff --git a/ContentPatcher/Framework/Patches/XnaValueConverter.cs b/ContentPatcher/Framework/Patches/XnaValueConverter.cs
new file mode 100644
index 0000000..156ce0c
--- /dev/null
+++ b/ContentPatcher/Framework/Patches/XnaValueConverter.cs
@@ -0,0 +1,107 @@
+using System;
+using System.Globalization;
+using System.Linq;
+using Microsoft.Xna.Framework;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+
+namespace ContentPatcher.Framework.Patches;
+
+/// <summary>Reads XNA position and area values in either the object form (<c>{ "X": 1, "Y": 2 }</c>) or the comma-delimited text form (<c>"1, 2"</c>), and writes the object form.</summary>
+internal class XnaValueConverter : JsonConverter
+{
+    /*********
+    ** Public methods
+    *********/
+    /// <inheritdoc />
+    public override bool CanConvert(Type objectType)
+    {
+        Type type = Nullable.GetUnderlyingType(objectType) ?? objectType;
+        return type == typeof(Vector2) || type == typeof(Point) || type == typeof(Rectangle);
+    }
+
+    /// <inheritdoc />
+    public override object? ReadJson(JsonReader reader, Type objectType, object? existingValue, JsonSerializer serializer)
+    {
+        Type type = Nullable.GetUnderlyingType(objectType) ?? objectType;
+        JToken token = JToken.Load(reader);
+
+        if (token.Type == JTokenType.Null)
+        {
+            if (type != objectType)
+                return null;
+            throw new JsonSerializationException($"Can't convert null to {type.Name}.");
+        }
+
+        float[] values = token switch
+        {
+            JObject obj => this.ReadObject(obj, type),
+            JValue { Type: JTokenType.String } str => this.ReadText((string)str!, type),
+            _ => throw new JsonSerializationException($"Can't convert {token.Type} to {type.Name}.")
+        };
+
+        if (type == typeof(Vector2))
+            return new Vector2(values[0], values[1]);
+        if (type == typeof(Point))
+            return new Point((int)values[0], (int)values[1]);
+        return new Rectangle((int)values[0], (int)values[1], (int)values[2], (int)values[3]);
+    }
+
+    /// <inheritdoc />
+    public override void WriteJson(JsonWriter writer, object? value, JsonSerializer serializer)
+    {
+        JObject obj = value switch
+        {
+            Vector2 vector => new JObject { ["X"] = vector.X, ["Y"] = vector.Y },
+            Point point => new JObject { ["X"] = point.X, ["Y"] = point.Y },
+            Rectangle rect => new JObject { ["X"] = rect.X, ["Y"] = rect.Y, ["Width"] = rect.Width, ["Height"] = rect.Height },
+            _ => throw new JsonSerializationException($"Can't write {value?.GetType().Name ?? "null"}.")
+        };
+        obj.WriteTo(writer);
+    }
+
+
+    /*********
+    ** Private methods
+    *********/
+    /// <summary>Get the field names for a type, in constructor order.</summary>
+    /// <param name="type">The value type.</param>
+    private string[] GetFieldNames(Type type)
+    {
+        return type == typeof(Rectangle)
+            ? ["X", "Y", "Width", "Height"]
+            : ["X", "Y"];
+    }
+
+    /// <summary>Read the values from the object form.</summary>
+    /// <param name="obj">The JSON object.</param>
+    /// <param name="type">The value type.</param>
+    private float[] ReadObject(JObject obj, Type type)
+    {
+        return this
+            .GetFieldNames(type)
+            .Select(name =>
+            {
+                JToken? field = obj.GetValue(name, StringComparison.OrdinalIgnoreCase);
+                return field?.Value<float>() ?? 0;
+            })
+            .ToArray();
+    }
+
+    /// <summary>Read the values from the comma-delimited text form.</summary>
+    /// <param name="text">The text to parse.</param>
+    /// <param name="type">The value type.</param>
+    private float[] ReadText(string text, Type type)
+    {
+        string[] names = this.GetFieldNames(type);
+        string[] parts = text.Split(',');
+        if (parts.Length != names.Length)
+            throw new JsonSerializationException($"Can't parse '{text}' as {type.Name}; expected {names.Length} comma-separated numbers.");
+
+        return parts
+            .Select(part => float.TryParse(part.Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out float value)
+                ? value
+                : throw new JsonSerializationException($"Can't parse '{text}' as {type.Name}; '{part.Trim()}' isn't a number."))
+            .ToArray();
+    }
+}
