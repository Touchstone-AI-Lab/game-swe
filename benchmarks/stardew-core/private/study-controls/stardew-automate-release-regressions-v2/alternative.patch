+    /// <summary>Discard a finished output which has no quantity, the same way the game does when the player empties such a machine by hand.</summary>
+    /// <returns>Returns whether an empty output was discarded.</returns>
+    protected bool TryDiscardEmptyOutput()
+    {
+        SObject? held = this.Machine.heldObject.Value;
+        if (held is null || held.Stack > 0 || !this.Machine.readyForHarvest.Value)
+            return false;
+
+        this.Machine.heldObject.Value = null;
+        this.Machine.readyForHarvest.Value = false;
+        this.Machine.showNextIndex.Value = false;
+        this.Machine.ResetParentSheetIndex();
+        return true;
+    }
+
