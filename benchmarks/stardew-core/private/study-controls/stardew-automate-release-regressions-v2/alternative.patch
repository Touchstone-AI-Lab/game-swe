+    /// <summary>Get the name which identifies one location instance. Building interiors of the same type share a <see cref="GameLocation.Name"/>, so their per-instance unique name is used when they have one.</summary>
+    /// <param name="location">The location instance.</param>
+    public static string? GetIdentity(GameLocation? location)
+    {
+        if (location is null)
+            return null;
+
