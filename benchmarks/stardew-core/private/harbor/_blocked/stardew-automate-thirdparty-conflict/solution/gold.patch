+    /// <summary>Get the automateable entities on a tile, skipping any entity whose
+    /// own code (or a third-party patch of it) throws. One broken entity must not stop
+    /// the rest of the location being scanned.</summary>
+    /// <param name="location">The location to search.</param>
+    /// <param name="locationIndex">An indexed view of the location.</param>
+    /// <param name="tile">The tile to search.</param>
+    private IEnumerable<IAutomatable?> GetEntitiesSafely(GameLocation location, LocationFloodFillIndex locationIndex, Vector2 tile)
+    {
+        List<IAutomatable?> entities = [];
+
+        using IEnumerator<IAutomatable?> cursor = this.GetEntities(location, locationIndex, tile).GetEnumerator();
+        while (true)
+        {
+            try
+            {
+                if (!cursor.MoveNext())
+                    break;
+            }
+            catch (Exception ex)
+            {
+                this.Monitor.Log($"Failed to check for automateable entities at {location.NameOrUniqueName} ({tile.X}, {tile.Y}). This is usually caused by another mod; the tile will be skipped.\n{ex}", LogLevel.Warn);
+                break;
+            }
+
+            entities.Add(cursor.Current);
+        }
+
+        return entities;
+    }
+
