<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../tModLoader.targets" />
  <PropertyGroup>
    <AssemblyName>GcbAequusCarpentry</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CandidateRoot Condition="'$(CandidateRoot)' == ''">/workspace/solution</CandidateRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GcbAequusCarpentry.cs" />
    <Compile Include="EngineSupport.cs" />
    <Compile Include="VerifierSystem.cs" />
    <Compile Include="$(CandidateRoot)/aequus/Common/Carpentry/BuildChallengeSaveData.cs" Link="Production/BuildChallengeSaveData.cs" />
  </ItemGroup>
</Project>
