<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CandidateRoot Condition="'$(CandidateRoot)' == ''">../environment/improvegame</CandidateRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CandidateRoot)/Content/Items/SpaceWand.Shapes.cs" Link="Production/SpaceWand.Shapes.cs" />
    <Compile Include="$(CandidateRoot)/Content/Items/SpaceWand.Operations.cs" Link="Production/SpaceWand.Operations.cs" />
    <Compile Include="$(CandidateRoot)/Content/Packets/SpaceWandOperation.cs" Link="Production/SpaceWandOperation.cs" />
    <Compile Include="VerifierSupport.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
