<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CandidateRoot Condition="'$(CandidateRoot)' == ''">../environment/fargos-mutant</CandidateRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CandidateRoot)/Common/Systems/Recipes/MiscRecipeSystem.cs" Link="Production/MiscRecipeSystem.cs" />
    <Compile Include="$(CandidateRoot)/Content/Items/Tiles/EnchantedTreeSheet.cs" Link="Production/EnchantedTreeSheet.cs" />
    <Compile Include="$(CandidateRoot)/Content/Items/Tiles/EnchantedTreeTileEntity.cs" Link="Production/EnchantedTreeTileEntity.cs" />
    <Compile Include="VerifierSupport.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
