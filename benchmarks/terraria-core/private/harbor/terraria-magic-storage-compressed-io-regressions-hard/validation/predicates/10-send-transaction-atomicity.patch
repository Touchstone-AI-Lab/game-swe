+		internal void WriteAtomically(Action<ValueWriter> write) {
+			ArgumentNullException.ThrowIfNull(write);
+
+			using MemoryStream stream = new();
+			ValueWriter stagedWriter = _globalArrayLengthWriter is null
+				? new ValueWriter(stream)
+				: new ValueWriter(stream, _globalArrayLengthWriter);
+
+			write(stagedWriter);
+			if (stagedWriter._activeScope is not null)
+				throw new InvalidOperationException("A staged write left a scope open.");
+
+			stagedWriter.Flush();
+			WriteContents(stream.ToArray(), stagedWriter._writtenBitCount);
+		}
+
+		private void WriteContents(byte[] bytes, ulong bitCount) {
+			if (bitCount > (ulong)bytes.LongLength * BitBuffer128.MAX_BYTE)
+				throw new ArgumentOutOfRangeException(nameof(bitCount));
+
+			int wholeBytes = checked((int)(bitCount / BitBuffer128.MAX_BYTE));
+			for (int i = 0; i < wholeBytes; i++)
+				Write(bytes[i], BitBuffer128.MAX_BYTE);
+
+			int remainingBits = (int)(bitCount % BitBuffer128.MAX_BYTE);
+			if (remainingBits > 0)
+				Write(bytes[wholeBytes], remainingBits);
+		}
