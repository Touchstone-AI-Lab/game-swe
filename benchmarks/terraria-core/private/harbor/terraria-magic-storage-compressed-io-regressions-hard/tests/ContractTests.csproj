<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CandidateRoot Condition="'$(CandidateRoot)' == ''">/workspace/magic-storage</CandidateRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CandidateRoot)/Common/RefContainer.cs" Link="Candidate/Common/RefContainer.cs" />
    <Compile Include="$(CandidateRoot)/Common/Utils/Utility.Math.cs" Link="Candidate/Common/Utils/Utility.Math.cs" />
    <Compile Include="$(CandidateRoot)/Common/IO/BitBuffer128.cs" Link="Candidate/Common/IO/BitBuffer128.cs" />
    <Compile Include="$(CandidateRoot)/Common/IO/LengthCompressor.cs" Link="Candidate/Common/IO/LengthCompressor.cs" />
    <Compile Include="$(CandidateRoot)/Common/IO/StringCompressor.cs" Link="Candidate/Common/IO/StringCompressor.cs" />
    <Compile Include="$(CandidateRoot)/Common/IO/ValueReader.cs" Link="Candidate/Common/IO/ValueReader.cs" />
    <Compile Include="$(CandidateRoot)/Common/IO/ValueWriter.cs" Link="Candidate/Common/IO/ValueWriter.cs" />
    <Compile Include="$(CandidateRoot)/Common/IO/NetCompression.NetIO.cs" Link="Candidate/Common/IO/NetCompression.NetIO.cs" />
    <Compile Include="VerifierSupport.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
