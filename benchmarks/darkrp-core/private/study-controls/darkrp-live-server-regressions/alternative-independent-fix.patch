+-- The members of the category with this name, when it has been declared before.
+local function membersOfExisting(destination, name)
+    for _, cat in pairs(destination) do
+        if cat.name == name then return cat.members end
+    end
+end
+
 function DarkRP.createCategory(tbl)
     local valid, err, hints = DarkRP.validateCategory(tbl)
     if not valid then DarkRP.error(string.format("Corrupt category: %s!\n%s", tbl.name or "", err), 2, hints) end
-    tbl.members = {}
 
     local destination = categories[tbl.categorises]
+
+    -- Declaring a category again replaces its settings, not its contents.
+    tbl.members = membersOfExisting(destination, tbl.name) or {}
     insertCategory(destination, tbl)
 
     -- Too many people made the mistake of not creating a category for weapons as well as shipments
     -- when having shipments that can also be sold separately.
     if tbl.categorises == "shipments" then
-        insertCategory(categories.weapons, tbl)
+        -- The weapons category is a category of its own, with its own member list.
+        local weaponCategory = {}
+        for key, value in pairs(tbl) do weaponCategory[key] = value end
+        weaponCategory.members = membersOfExisting(categories.weapons, tbl.name) or {}
+
+        insertCategory(categories.weapons, weaponCategory)
     end
 end
 
