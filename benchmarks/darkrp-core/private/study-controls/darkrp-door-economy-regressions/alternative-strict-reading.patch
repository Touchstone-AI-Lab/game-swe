@@ -3,9 +3,17 @@
 
 function pMeta:canAfford(amount)
     if not amount or self.DarkRPUnInitialized then return false end
+
+    -- A price below zero is not a price: "paying" it would add money to the wallet.
+    if amount < 0 then return false end
+
     return (self:getDarkRPVar("money") or 0) - math.ceil(amount) >= 0
 end
 
 function entMeta:isMoneyBag()
+    -- Money that was dropped or spawned in the world is a spawned_money entity (or a
+    -- derivative of it), whatever class the config names for bought money.
+    if self.IsSpawnedMoney then return true end
+
     return self:GetClass() == GAMEMODE.Config.MoneyClass
 end
