 --[[---------------------------------------------------------------------------
+Querying who is arrested
+The list is the primitive; the iterator and the count are derived from it so the
+three can never disagree.
+---------------------------------------------------------------------------]]
+function DarkRP.arrestedPlayers()
+    local arrested = {}
+
+    for _, ply in ipairs(player.GetAll()) do
+        if IsValid(ply) and ply:isArrested() then
+            arrested[#arrested + 1] = ply
+        end
+    end
+
+    return arrested
+end
+
+function DarkRP.iterateArrestedPlayers()
+    -- Iterate over a snapshot, so arresting or releasing someone inside the loop
+    -- cannot upset the traversal.
+    local snapshot = DarkRP.arrestedPlayers()
+    local position = 0
+
+    return function()
+        position = position + 1
+        return snapshot[position]
+    end
+end
+
+function DarkRP.arrestedPlayerCount()
+    return #DarkRP.arrestedPlayers()
+end
