  "clauses": [
    {
      "id": "public-centers",
      "anchor": "CONTRACT.md paragraph 1: \"Preserve its public centers and the core API in `API.md`\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "discard-charges-all",
      "anchor": "CONTRACT.md paragraph 2: \"Each **valid player discard operation**, regardless of cards discarded, gives every currently owned physical instance +2 charge\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "charge-cap",
      "anchor": "CONTRACT.md paragraph 2: \"capped at 6\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "no-passive-charge",
      "anchor": "CONTRACT.md paragraph 2: \"Holding, display queries, ordering, acquisition and selling do not generate charge.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "fresh-zero",
      "anchor": "CONTRACT.md paragraph 2: \"A newly acquired instance starts at zero\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "sell-own-state",
      "anchor": "CONTRACT.md paragraph 2: \"selling one removes only its own state\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "physical-identity",
      "anchor": "CONTRACT.md paragraph 2: \"Charge belongs to physical identity, never row position.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "additive-mult",
      "anchor": "CONTRACT.md paragraph 3: \"Each instance contributes its current charge as additive Mult to the next real hand's main Joker scoring.\"",
      "status": "asserted",
      "note": "Scores assert the summed bonus of all instances, not each instance's share; see known_issues."
    },
    {
      "id": "consume-once",
      "anchor": "CONTRACT.md paragraph 3: \"After that instance participates, consume its charge once, including a legitimate zero.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "no-repeat-callback",
      "anchor": "CONTRACT.md paragraph 3: \"Further callbacks for the same operation cannot accumulate or consume again.\"",
      "status": "asserted",
      "note": "Asserted through outcomes only: the callback rows recorded by fixture.lua:26-40 are read by no case."
    },
    {
      "id": "next-hand-clear",
      "anchor": "CONTRACT.md paragraph 3: \"The next hand has no old bonus.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "display-pure",
      "anchor": "CONTRACT.md paragraph 3: \"`loc_vars(...).vars[1]` is a pure numeric display of that instance's current balance.\"",
      "status": "asserted",
      "note": "Every charge observation reads it through fixture.lua:8-12, also around each relevant callback, so an impure display would shift the asserted balances."
    },
    {
      "id": "recruit-consumed",
      "anchor": "CONTRACT.md paragraph 4: \"is consumed normally on use and creates one fresh charge Joker\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "recruit-capacity",
      "anchor": "CONTRACT.md paragraph 4: \"when ordinary Joker capacity permits\"",
      "status": "unasserted",
      "note": "Joker capacity is 5 and at most two targets exist (scenario.py:109), so creation at full capacity is never driven."
    },
    {
      "id": "recruit-no-transfer",
      "anchor": "CONTRACT.md paragraph 4: \"It does not transfer a sold instance's charge.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "restore-membership",
      "anchor": "CONTRACT.md paragraph 5: \"must preserve physical membership\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "restore-balances",
      "anchor": "CONTRACT.md paragraph 5: \"balances (including zero)\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "restore-history",
      "anchor": "CONTRACT.md paragraph 5: \"core event history\"",
      "status": "asserted",
      "note": "Natively through continued play after the zero checkpoint; replay semantics through core.restored_history."
    },
    {
      "id": "restore-entry",
      "anchor": "CONTRACT.md paragraph 5: \"The supported restore entry is\"",
      "status": "asserted",
      "note": "Shown to have run by runtime-sentinel cases; it is the path every restored case depends on."
