  "clauses": [
    {
      "id": "booster-offer",
      "anchor": "CONTRACT.md paragraph 2: \"The ordinary `p_pc2_choices` Booster costs $4 and presents three physical Common Jokers, in order\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "choose-at-most-two",
      "anchor": "CONTRACT.md paragraph 2: \"Choose at most two through normal game actions.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "signing-rewards",
      "anchor": "CONTRACT.md paragraph 2: \"Their signing rewards are respectively $3, $5 and $7.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "no-recurring-effect",
      "anchor": "CONTRACT.md paragraph 2: \"They have no recurring scoring or money effect\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "native-cost-resale",
      "anchor": "CONTRACT.md paragraph 2: \"their ordinary cost is $4 and native resale rules apply\"",
      "status": "weak",
      "note": "The expected sale credit is the object's observed sell_cost (scenario.py:74), not an independent value, and the $4 cost is never compared."
    },
    {
      "id": "no-preview-reward",
      "anchor": "CONTRACT.md paragraph 3: \"Opening, creating, displaying or destroying an unchosen preview gives no reward.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "reward-once-per-object",
      "anchor": "CONTRACT.md paragraph 3: \"Each actual selected-and-acquired physical object commits its own reward exactly once.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "deferred-payout",
      "anchor": "CONTRACT.md paragraph 3: \"Pay that reward in a normally scheduled deferred game event\"",
      "status": "weak",
      "note": "The tracked event rows are read by no case, so a synchronous payment settles to the same observations; only pending_events==0 is checked."
    },
    {
      "id": "no-unpaid-work",
      "anchor": "CONTRACT.md paragraph 3: \"after the action has settled, no unpaid work remains\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "partial-skip-keeps-reward",
      "anchor": "CONTRACT.md paragraph 3: \"If the player selects one and skips the rest, retain the selected reward and grant nothing for unselected items.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "skip-all-zero",
      "anchor": "CONTRACT.md paragraph 3: \"Skipping all grants zero.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "two-choice-sum",
      "anchor": "CONTRACT.md paragraph 3: \"Choosing two grants the sum of those two objects' rewards, regardless of shifted preview positions.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "separate-sessions",
      "anchor": "CONTRACT.md paragraph 4: \"Each opened pack has a separate session and new preview identities.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "no-inherited-marker",
      "anchor": "CONTRACT.md paragraph 4: \"The next pack cannot inherit a prior choice or paid marker.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "close-keeps-pending",
      "anchor": "CONTRACT.md paragraph 4: \"Closing a session prevents new commits but does not cancel already committed pending rewards.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "repeated-operations",
      "anchor": "CONTRACT.md paragraph 4: \"Repeated normal operations remain usable.\"",
      "status": "asserted",
