  "clauses": [
    {
      "id": "instance-quantity",
      "anchor": "CONTRACT.md paragraph 2: \"Each physical Generator carries its own integer quantity `card.ability.extra.products`\"",
      "status": "asserted",
      "note": "Scenes configure quantities 1, 2 and 3; the mixed scene runs 1 and 3 on separate sources in one run."
    },
    {
      "id": "config-immutable",
      "anchor": "CONTRACT.md paragraph 2: \"never mutate the shared center default or another instance's configuration\"",
      "status": "asserted",
      "note": "Read only by the .sealed cases, whose role is runtime-sentinel: they compare poc.bg2.config after all actions with the prepared values (scenario.py:137-139)."
    },
    {
      "id": "creates-quantity",
      "anchor": "CONTRACT.md paragraph 3: \"creates exactly that instance's quantity of distinct ordinary Mercury Planets\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "no-selection",
      "anchor": "CONTRACT.md paragraph 3: \"No playing-card selection is needed.\"",
      "status": "asserted",
      "note": "Every use request carries only the consumable index (protocol_v1.py:18)."
    },
    {
      "id": "source-consumed-once",
      "anchor": "CONTRACT.md paragraph 3: \"The source is consumed once by the native lifecycle\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "products-usable",
      "anchor": "CONTRACT.md paragraph 3: \"Products remain normal usable Planets\"",
      "status": "asserted",
      "note": "Products are used in the room, three, recover and mixed scenes; the one scene never uses its product."
    },
    {
      "id": "admission-formula",
      "anchor": "CONTRACT.md paragraph 4: \"allow Use exactly when `N - 1 + B + q <= L`\"",
      "status": "asserted",
      "note": "Accepted at the exact limit for q=1, 2 and 3. Refused only for q=3, one slot over. The B term is the separate clause admission-reservation-term."
    },
    {
      "id": "admission-reservation-term",
      "anchor": "CONTRACT.md paragraph 4: \"outstanding native reservation count B (`G.GAME.consumeable_buffer`)\"",
      "status": "unasserted",
      "note": "Every Use starts from B=0: settled() waits for pending_events==0 between actions (observe_v1.py:18-19) and the previous job must leave the buffer at 0. An admission that ignores B passes every case."
    },
    {
      "id": "self-slot",
      "anchor": "CONTRACT.md paragraph 4: \"Consumption of the source releases its own slot.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "check-before-mutation",
      "anchor": "CONTRACT.md paragraph 4: \"Capacity is checked before any use-side mutation.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "can-use-pure",
      "anchor": "CONTRACT.md paragraph 4: \"Can-use and display queries are pure\"",
      "status": "asserted",
      "note": "pure_admission compares buffer and inventory count at the return of the native can_use_consumeable call with the pre-action observation (scenario.py:80-84)."
    },
    {
      "id": "display-query-pure",
      "anchor": "CONTRACT.md paragraph 4: \"do not reserve, consume or create anything\"",
      "status": "weak",
      "note": "The .queries cases only poll gamestate four times. OBSERVATION-NOTE-v1.md states that serializer does not call can_use, and no case calls loc_vars directly, so display code may not run at all."
    },
    {
      "id": "refusal-atomic",
      "anchor": "CONTRACT.md paragraph 5: \"refuse before consuming the source, adding products, recording successful use or changing reservations\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "refusal-retains-source",
      "anchor": "CONTRACT.md paragraph 5: \"Preserve all original physical objects and their properties, the quantity and the right to use that source later.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "retry-after-space",
      "anchor": "CONTRACT.md paragraph 5: \"After the player legitimately frees space, the same source can be used once if the formula permits.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "job-reserves-quantity",
