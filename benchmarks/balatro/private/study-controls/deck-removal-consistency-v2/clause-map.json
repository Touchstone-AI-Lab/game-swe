  "clauses": [
    {
      "id": "consume-once",
      "anchor": "CONTRACT.md paragraph 2: \"A normal successful Use in SELECTING_HAND consumes this Tarot once\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "destroy-exact-selection",
      "anchor": "CONTRACT.md paragraph 2: \"permanently destroys exactly the **one to four selected physical playing-card objects**\"",
      "status": "asserted",
      "note": "Batch sizes 1, 3 and 4 run (scenario.py:12,164); size 2 is not exercised."
    },
    {
      "id": "highlighted-set-targets",
      "anchor": "CONTRACT.md paragraph 2: \"Selection is the highlighted set at that use, not a prefix of the hand\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "destroyed-once",
      "anchor": "CONTRACT.md paragraph 2: \"Each selected object is destroyed once.\"",
      "status": "weak",
      "note": "Only consequences are checked (removed flag, registry and limit); the fixture counts no destruction calls."
    },
    {
      "id": "selection-order-irrelevant",
      "anchor": "CONTRACT.md paragraph 2: \"The order of selections does not change the resulting target set.\"",
      "status": "unasserted",
      "note": "Every use passes ascending indices: [0], [0,2,5,7], [1,4,7] and [3] (scenario.py:12,164). No case varies selection order."
    },
    {
      "id": "remove-from-all-stores",
      "anchor": "CONTRACT.md paragraph 3: \"Remove each selected object from the active card area, the persistent playing-card registry and the subsequent draw pool.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "deck-bookkeeping",
      "anchor": "CONTRACT.md paragraph 3: \"The registered deck count and its ordinary deck-size bookkeeping decrease\"",
      "status": "asserted",
      "note": "Observed as G.deck.config.card_limit (fixture.lua:44)."
    },
    {
      "id": "native-destruction-complete",
      "anchor": "CONTRACT.md paragraph 3: \"Normal destruction completes through the native lifecycle; do not leave dangling live objects, duplicates, or pending work.\"",
      "status": "asserted",
      "note": "The lifecycle field events=bool(current['events']) is a cumulative list and adds nothing per action (scenario.py:127); pending, buffer and stable carry this clause."
    },
    {
      "id": "survivors-unchanged",
      "anchor": "CONTRACT.md paragraph 4: \"Every unselected physical card keeps its identity, rank, suit and ordinary base-card state.\"",
      "status": "asserted",
      "note": "Compared fields are id, rank, suit, center and removed (fixture.lua:31-35); seals and editions are outside the observation and outside the contract scope."
    },
    {
      "id": "duplicate-face-survivor",
      "anchor": "CONTRACT.md paragraph 4: \"This includes an unselected card with the same rank and suit as a selected card.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "no-lookalike-replacement",
      "anchor": "CONTRACT.md paragraph 4: \"Do not replace survivors with newly created lookalikes or change their attributes.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "resources-unchanged",
      "anchor": "CONTRACT.md paragraph 4: \"Other consumables, money, poker-hand levels and normal hand capacity stay unchanged\"",
      "status": "asserted",
      "note": "Hand capacity is inferred from later draws back to 8; the limit itself is not observed."
    },
    {
      "id": "play-continues",
      "anchor": "CONTRACT.md paragraph 5: \"After completion, normal play, refill, round completion and entry to a later blind still work.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "removed-never-return",
      "anchor": "CONTRACT.md paragraph 5: \"Permanently removed cards never return in later deals.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "later-cut-fresh-selection",
      "anchor": "CONTRACT.md paragraph 5: \"A later independently owned Clean Cut follows the same rule against its own current selection\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "repeated-consistency",
      "anchor": "CONTRACT.md paragraph 5: \"Repeated operations keep the registry, areas, counts and remaining draw pool consistent.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "invalid-selection-rejected",
      "anchor": "CONTRACT.md paragraph 6: \"An empty selection or selection above the maximum is rejected by the fixed normal interface before effect execution\"",
      "status": "asserted",
      "note": "Refusal is performed by the fixed endpoint, not by candidate code; see known_issues."
    },
    {
      "id": "structured-refusal",
      "anchor": "CONTRACT.md paragraph 6: \"Only a verified structured business refusal with matching request identity counts as refusal.\"",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "no-external-alteration",
      "anchor": "CONTRACT.md paragraph 8: \"Do not alter evaluator/observer/fixture/runtime, fixed components, original installation, personal data or external files.\"",
      "status": "unasserted",
      "note": "No evaluator case. A harness input-integrity field gates the whole result (plugins/balatro/src/rhenium_balatro/evaluator.py:33-37)."
    },
    {
      "id": "file-boundary",
      "anchor": "CONTRACT.md paragraph 9: \"Editable files: `main.lua` and `lib/lifecycle.lua`; immutable file: `deck_removal_consistency_v2.json`.\"",
      "status": "unasserted",
      "note": "No evaluator case. The submission gate rejects a changed file set or immutable file before evaluation (plugins/balatro/src/rhenium_balatro/submission.py:28-47)."
    }
