  "clauses": [
    {
      "id": "req-1",
      "anchor": "Required behavior, bullet 1: add public static ResolveMaterialBasis(Thing item) as the shared API",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "req-2",
      "anchor": "Required behavior, bullet 2: a non-empty CostListAdjusted list is returned unchanged and beats every extension",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "req-3",
      "anchor": "Required behavior, bullet 3: otherwise a non-empty R4MaterialCostExtension.materials list; missing, null or empty falls through",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "req-4",
      "anchor": "Required behavior, bullet 4: synthesis from abstract MarketValue, max(0)*0.15f / max(0.01f, bulk), RoundToInt nearest-even, at least one unit",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "req-5",
      "anchor": "Required behavior, bullet 5: tech mapping (Undefined as Industrial; Spacer+ Plasteel and two spacer components; Industrial Steel and two components; lower Steel only)",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "req-6",
      "anchor": "Required behavior, bullet 6: GetRepairCycleCost and GetCleanCost consume the resolved basis with their separate formulas, threshold and fallback",
      "status": "asserted",
      "note": ""
    },
    {
      "id": "req-7",
      "anchor": "Required behavior, bullet 7: preserve all unrelated R4 behavior",
      "status": "unasserted",
      "note": "recycling, placement, eligibility, DoRecycleProducts and SpawnPartialReclaim are declared out of the scored scope"
    },
    {
      "id": "delivery",
      "anchor": "closing paragraph: do not add RimWorld, Unity or Harmony binaries, generated output, test results, credentials, Workshop content, assets, saves or logs",
      "status": "weak",
      "note": "the snapshot gate rejects binaries, links and harness markers; the other listed artefacts are not checked"
    }
  ],
