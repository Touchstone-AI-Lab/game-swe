+    /**
+     * Registers one channel built by {@code factory}; a channel that cannot be
+     * built is reported through the plugin logger with its id and left out so the
+     * remaining channels (and the plugin) still load.
+     */
+    private static void register(NotificationTicker ticker, Plugin plugin, String type,
+                                 String channelId, Callable<? extends Notification> factory) {
+        Notification notification;
+        try {
+            notification = factory.call();
+        } catch (Exception e) {
+            plugin.getLogger().log(Level.WARNING,
+                    "notifications.yml: skipped the {0} channel \"{1}\" because it cannot be built: {2}",
+                    new Object[]{type, channelId, e.getMessage() == null ? e.toString() : e.getMessage()});
+            return;
+        }
+        ticker.addNotification(notification);
+    }
