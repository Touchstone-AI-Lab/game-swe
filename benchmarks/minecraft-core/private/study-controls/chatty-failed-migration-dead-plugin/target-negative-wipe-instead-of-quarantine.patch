+    /**
+     * The migrated files could not be loaded: keep the operator informed and bring the plugin up
+     * on a default configuration instead of leaving an enabled plugin that handles nothing.
+     */
+    private void recoverFromFailedMigration(Path dataFolderPath, String backupFolderName, Throwable failure)
+            throws Exception {
+        getLogger().log(Level.SEVERE, "Failed to migrate the legacy configuration. Your v2 files are kept in \""
+                + backupFolderName + "\": fix the problem reported below, move its config.yml back into the"
+                + " plugin folder and restart the server.", failure);
+        tearDownQuietly();
+        if (Files.isDirectory(dataFolderPath)) {
+            try (Stream<Path> tree = Files.walk(dataFolderPath)) {
+                tree.sorted(Comparator.reverseOrder()).forEach(path -> {
+                    try {
+                        Files.delete(path);
+                    } catch (IOException e) {
+                        throw new UncheckedIOException(e);
+                    }
+                });
+            }
+            getLogger().warning("The half-migrated files were discarded; Chatty regenerates its defaults.");
+        }
+        initialize();
+        getLogger().warning("Chatty started with a default configuration instead.");
+    }
+
+    /** Releases whatever the failed initialisation left behind; errors here must not stop the recovery. */
+    private void tearDownQuietly() {
+        try {
+            closeResources();
+        } catch (Throwable t) {
+            getLogger().log(Level.WARNING, "Ignoring an error while releasing the failed configuration", t);
+        }
+    }
