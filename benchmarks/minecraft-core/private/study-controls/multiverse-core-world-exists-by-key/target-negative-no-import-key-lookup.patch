     /**
+     * A world is registered under both its legacy name and its key string, while a request may
+     * carry either identity: check both before deciding that the requested world is new.
+     */
+    private boolean hasLoadedWorld(@NotNull WorldKeyOrName keyOrName) {
+        return isLoadedWorld(keyOrName.usableName())
+                || isLoadedWorld(keyOrName.usableKey().toString());
+    }
+
+    private boolean hasWorld(@NotNull WorldKeyOrName keyOrName) {
+        return isWorld(keyOrName.usableName())
+                || isWorld(keyOrName.usableKey().toString());
+    }
