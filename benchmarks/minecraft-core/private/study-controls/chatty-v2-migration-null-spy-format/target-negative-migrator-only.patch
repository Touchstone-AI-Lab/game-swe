+    /**
+     * v2 always rendered a spy line: a missing template meant the bundled default and a chat
+     * without its own format used the default format, so the migrated value is never absent.
+     */
+    private static String spyFormatFor(@Nullable String template, @Nullable String chatFormat) {
+        String spyTemplate = template == null || template.isBlank() ? V2_DEFAULT_SPY_TEMPLATE : template;
+        String format = chatFormat == null || chatFormat.isBlank() ? V3_DEFAULT_CHAT_FORMAT : chatFormat;
+        return spyTemplate.replace("{format}", format);
+    }
