{
  "schemaVersion": 1,
  "taskId": "betterteams-help-page-bounds",
  "pluginName": "BetterTeams",
  "build": {
    "tool": "maven",
    "wrapper": false,
    "toolVersion": "3.9.11",
    "module": "BetterTeams",
    "assemble": "package",
    "test": "test",
    "artifact": "server/plugins/BetterTeams-5.1.0.jar",
    "javaRelease": 21,
    "frozenPaths": [
      "pom.xml",
      "BetterTeams/pom.xml",
      "BetterTeams/src/test",
      "extensions/pom.xml",
      "extensions/discord-extension/pom.xml",
      "extensions/luckperms-extension/pom.xml",
      "extensions/zkoth-extension/pom.xml",
      ".mvn",
      "mvnw",
      "mvnw.cmd"
    ]
  },
  "unitCases": [
    "sort() Tests.testComplexGraph",
    "sort() Tests.testHardCircularDependency",
    "sort() Tests.testNoDependencies",
    "sort() Tests.testTransitiveDependency",
    "scanExtensions() Tests.testMixedValidAndInvalid",
    "scanExtensions() Tests.testDuplicateNames",
    "scanExtensions() Tests.testMultipleValidJars",
    "ExtensionClassLoader Global Access Tests.testLoadClassFromOtherExtension",
    "ExtensionClassLoader Global Access Tests.testClassNotFound",
    "ExtensionClassLoader Global Access Tests.testSelfPriority",
    "fromYaml() Loading Tests.testDefaultValues",
    "fromYaml() Loading Tests.testNullFile",
    "fromYaml() Loading Tests.testMissingYml",
    "fromYaml() Loading Tests.testMissingMainInYml",
    "fromYaml() Loading Tests.testMissingMainClassInJar",
    "fromYaml() Loading Tests.testSuccessfulLoad",
    "fromYaml() Loading Tests.testNonExistentFile",
    "unload() Tests.testUnloadSuccess",
    "enable() Tests.testEnableFailsMissingPluginDep",
    "enable() Tests.testEnableAlreadyEnabled",
    "enable() Tests.testEnableSuccess",
    "disable() Tests.testDisableSuccess",
    "disable() Tests.testDisableAlreadyDisabled",
    "load() Tests.testLoadWrongMainClass",
    "load() Tests.testLoadSuccess",
    "load() Tests.testLoadNoJar",
    "Full Lifecycle Integration Test.testFullLifecycle",
    "Static and Ranked Placeholder Tests.testRankedPlaceholder_RankOutOfBounds",
    "Static and Ranked Placeholder Tests.testStaticTeamPlaceholder_TeamNotFound",
    "Static and Ranked Placeholder Tests.testRankedPlaceholder_InvalidRank",
    "Static and Ranked Placeholder Tests.testRankedPlaceholder_Score",
    "Static and Ranked Placeholder Tests.testStaticTeamPlaceholder_Success",
    "Static and Ranked Placeholder Tests.testRankedPlaceholder_Balance",
    "Static and Ranked Placeholder Tests.testStaticPlayerPlaceholder_PlayerNotFound",
    "Static and Ranked Placeholder Tests.testStaticPlayerPlaceholder_Success",
    "onRequest() Player-Specific Tests.testPlayerInTeamForInTeamPlaceholder",
    "onRequest() Player-Specific Tests.testPlayerNotInTeamForInTeamPlaceholder",
    "onRequest() Player-Specific Tests.testDataPlaceholderRequest",
    "onRequest() Player-Specific Tests.testRequestWithNullPlayer",
    "onRequest() Player-Specific Tests.testStandardPlaceholderRequest",
    "onRequest() Player-Specific Tests.testPlayerNotInTeamForTeamSpecificPlaceholder",
    "Cache Logic Tests.testInvalidateCache",
    "Cache Logic Tests.testPlayerSpecificPlaceholderIsNotCached",
    "Cache Logic Tests.testStaticPlaceholderIsCached"
  ],
  "serverCases": [
    "plugin is enabled",
    "help without a page shows the first page",
    "an explicit page number selects that page",
    "the last page shows the remaining commands",
    "help for one command is unchanged",
    "help entries carry the plugin prefix",
    "page zero and negative pages fall back to the first page",
    "pages past the end show the last page",
    "a page argument that is not a number shows the first page",
    "chest claim broadcasts carry the plugin prefix"
  ],
  "hiddenUnitOverlay": false
}
